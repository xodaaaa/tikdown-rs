# =============================================================
# TikDown-rs — variables de entorno (EJEMPLO)
# Copia a .env y rellena con valores REALES. Nunca commitees .env
# ni valores reales en este archivo.
# =============================================================

# --- Rutas ---
# Directorio de datos persistente (base de datos, fernet.key, archivo de
# deduplicación, vídeos). Todo deriva de aquí — jamás rutas relativas al cwd.
DATA_DIR=/app/data

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Telegram (opcional; recomendado para control remoto) ---
# Modo del bot: disabled | commands | both
#   disabled = bot apagado | commands = solo comandos | both = comandos + notificaciones
TELEGRAM_BOT_MODE=disabled
# Token del bot (BotFather). Valor vacío = bot apagado.
TELEGRAM_BOT_TOKEN=
# Chat ID permitido para control remoto (modo commands).
TELEGRAM_CHAT_ID=
# Polling timeout en segundos.
TELEGRAM_POLLING_TIMEOUT=25

# --- Cifrado de cookies ---
# Clave Fernet (base64 urlsafe, 32 bytes). Si se deja vacía, se genera una
# clave nueva en DATA_DIR/fernet.key en el primer arranque.
# ⚠ RESPALDA fernet.key FUERA del volumen de datos: sin ella, las cookies
# almacenadas son irrecuperables (ver README §Recuperación).
FERNET_KEY=

# --- yt-dlp / descarga ---
# Formato de descarga (override global del formato recomendado).
# Vacío = formato por defecto del plan (§4.2).
DOWNLOAD_FORMAT=
# Timeout por vídeo en segundos.
DOWNLOAD_TIMEOUT_SECONDS=600

# --- Monitor / daemon ---
# Intervalo del ciclo del monitor (segundos).
MONITOR_INTERVAL_SECONDS=300
# Throttle de comprobación manual por cuenta (segundos).
CHECK_THROTTLE_SECONDS=30
# Heartbeat del daemon (segundos).
HEARTBEAT_INTERVAL_SECONDS=10
# Intervalo de validación periódica de cookies (segundos).
COOKIE_VALIDATION_INTERVAL_SECONDS=3600
# Intervalo del selfcheck periódico (segundos).
SELFCHECK_INTERVAL_SECONDS=86400
# Cooldown global entre descargas (segundos).
PACING_COOLDOWN_SECONDS=10

# --- Backups ---
# Número de snapshots de backup a conservar.
SYSTEM_BACKUP_RETAIN_COUNT=5

# --- Red (probe) ---
# Endpoint neutral para el probe de red (nunca TikTok).
NETWORK_PROBE_URL=https://example.com
# Timeout del probe (segundos).
NETWORK_PROBE_TIMEOUT_SECONDS=5
