# =============================================================
# TikDown-rs — variables de entorno (EJEMPLO)
# Copia a .env y rellena con valores REALES. Nunca commitees .env
# ni valores reales en este archivo.
#
# Sincronizado campo a campo con Settings (core/config.py).
# Un test de higiene (tests/test_repo_hygiene.py) valida la
# sincronía: cualquier campo nuevo de Settings debe reflejarse aquí.
# =============================================================

# --- Rutas ---
# Directorio de datos persistente (base de datos, fernet.key, archivo de
# deduplicación, vídeos). Todo deriva de aquí — jamás rutas relativas al cwd.
DATA_DIR=/app/data

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Logs a archivo rotado (vacío = solo stdout). Ruta relativa a DATA_DIR no
# admitida: usa ruta absoluta o vacía.
LOG_FILE_PATH=
# Rotación por tamaño (bytes) y retención de ficheros rotados.
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=7
# 'size' | 'midnight' (rotación temporal diaria).
LOG_FILE_WHEN=size

# --- Telegram (opcional; recomendado para control remoto) ---
# Modo del bot: notifications | commands | both
#   notifications = solo eventos push | commands = solo comandos | both = ambos
# (para dejar el bot apagado, deja TELEGRAM_BOT_TOKEN vacío).
# El modo commands/both requiere TELEGRAM_CHAT_ID (validate_for_daemon).
TELEGRAM_BOT_MODE=commands
# Token del bot (BotFather). Valor vacío = bot apagado.
TELEGRAM_BOT_TOKEN=
# Chat ID permitido para control remoto.
TELEGRAM_CHAT_ID=
# Usuario(s) autorizados (opcional): lista separada por comas de from_user.id.
# Vacío = solo el propietario del chat.
TELEGRAM_USER_ID=
# Notificaciones push externas (requiere TELEGRAM_BOT_TOKEN).
# NOTA: hoy es un noop — ver README, sección notificaciones (auditoría 3.2).
ENABLE_EXTERNAL_NOTIFICATIONS=false

# --- Cifrado de cookies ---
# Clave Fernet (base64 urlsafe, 32 bytes). Si se deja vacía, se genera una
# clave nueva en DATA_DIR/fernet.key en el primer arranque.
# ⚠ RESPALDA fernet.key FUERA del volumen de datos: sin ella, las cookies
# almacenadas son irrecuperables (ver README §Recuperación).
FERNET_KEY=

# --- yt-dlp / descarga ---
# Formato de descarga (override global del formato recomendado).
# Vacío = formato por defecto del plan (§4.2).
DOWNLOAD_FORMAT=
# Descargas simultáneas (1 = secuencial, recomendado).
MAX_CONCURRENT_DOWNLOADS=1
# Cooldown global entre descargas: se sortea uniforme en [MIN, MAX] segundos (T62).
GLOBAL_DOWNLOAD_COOLDOWN_MIN_SECONDS=30
GLOBAL_DOWNLOAD_COOLDOWN_MAX_SECONDS=120
# Backoff anti-bot de yt-dlp: base y techo (segundos).
YTDLP_ANTIBOT_BACKOFF_BASE_SECONDS=10
YTDLP_ANTIBOT_BACKOFF_CEILING_SECONDS=120
# Techo de reintentos por vídeo y presupuesto total de tiempo (segundos).
MAX_VIDEO_RETRY_COUNT=5
MAX_VIDEO_TOTAL_TIME_SECONDS=900
# Proxy(es) para yt-dlp: lista separada por comas (opcional, §4.7).
YTDLP_PROXY_URL=
# Passthrough de extractor-args a yt-dlp (opcional, §12).
YTDLP_EXTRACTOR_ARGS=

# --- Monitor / daemon ---
# Intervalo del ciclo del monitor (MINUTOS).
MONITOR_INTERVAL_MINUTES=5
# El monitor siempre arranca detenido (§5.1); control vía monitor start/stop.
MONITOR_AUTOSTART=false
# Heartbeat del daemon (segundos). Frescura del healthcheck = 3x este valor (T50).
HEARTBEAT_INTERVAL_SECONDS=10
# Umbral de alerta por contención de DB (db_busy timeouts en 5 min).
DB_BUSY_TIMEOUT_ALERT_THRESHOLD=20
# Umbral de alerta de disco (% libre; por debajo = ALERTA).
DISK_WARNING_FREE_PERCENT=10
# Intervalo del job de disco (segundos; T65: 15-30 min).
DISK_CHECK_INTERVAL_SECONDS=900

# --- Cookies ---
# Sonda(s) de validación de cookies (§7): URLs separadas por comas.
COOKIE_VALIDATION_URL=

# --- Backups ---
# Número de snapshots de backup a conservar.
SYSTEM_BACKUP_RETAIN_COUNT=7

# --- Red (probe) ---
# Endpoints neutrales para el probe de red, separados por coma (nunca TikTok).
NETWORK_PROBE_URL=https://example.com
# Intervalo entre probes (segundos).
NETWORK_PROBE_INTERVAL_SECONDS=30
# Timeout de cada probe (segundos).
NETWORK_PROBE_TIMEOUT_SECONDS=5
# Fallos consecutivos para considerar la red caída.
NETWORK_OFFLINE_THRESHOLD_CONSECUTIVE_FAILURES=2
